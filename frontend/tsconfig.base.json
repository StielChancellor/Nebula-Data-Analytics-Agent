{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@insnav/locale": ["./packages/locale/src/index.ts"],
      "@insnav/brand-runtime": ["./packages/brand-runtime/src/index.ts"],
      "@insnav/brand-static": ["./packages/brand-static/src/index.ts"],
      "@insnav/api-client": ["./packages/api-client/src/index.ts"],
      "@insnav/ui-kit": ["./packages/ui-kit/src/index.ts"],
      "@insnav/pivot": ["./packages/pivot/src/index.ts"],
      "@insnav/dashboards": ["./packages/dashboards/src/index.ts"],
      "@insnav/chat": ["./packages/chat/src/index.ts"],
      "@insnav/charts": ["./packages/charts/src/index.ts"],
      "@insnav/share-embed": ["./packages/share-embed/src/index.ts"],
      "@insnav/auth": ["./packages/auth/src/index.ts"]
    }
  }
}
