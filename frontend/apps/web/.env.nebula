# Per-brand build env. Loaded by `vite build --mode nebula` and `vite --mode nebula`.
# These are NOT secrets — VITE_* values are baked into the build output and
# visible to anyone with the bundle.
VITE_BRAND=nebula
# Phase 1: in dev, leave this unset and the Vite proxy forwards /api → http://localhost:8000.
# In production, set this to the deployed backend Cloud Run URL.
VITE_API_BASE=/api
